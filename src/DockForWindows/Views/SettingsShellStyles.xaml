<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:DockForWindows.Views">
  <!-- Settings window controls. Values below are the light (Porcelain) defaults; SettingsShellWindow
       replaces every brush from DesignSystem at runtime, so light and dark share one set of templates.
       Light falls from above: controls carry a faint top sheen and a soft shadow underneath. -->
  <SolidColorBrush x:Key="SettingsInk" Color="#1D1D1F"/>
  <SolidColorBrush x:Key="SettingsMuted" Color="#6E6E73"/>
  <SolidColorBrush x:Key="SettingsTertiary" Color="#A1A1A6"/>
  <SolidColorBrush x:Key="SettingsLine" Color="#173C3C43"/>
  <SolidColorBrush x:Key="SettingsCard" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SettingsField" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SettingsCanvas" Color="#F5F5F7"/>
  <SolidColorBrush x:Key="SettingsSidebar" Color="#ECECEF"/>
  <SolidColorBrush x:Key="SettingsHero" Color="#12767680"/>
  <SolidColorBrush x:Key="SettingsTrack" Color="#24787880"/>
  <SolidColorBrush x:Key="SettingsQuiet" Color="#12767680"/>
  <SolidColorBrush x:Key="SettingsIndicator" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SettingsSidebarInk" Color="#1D1D1F"/>
  <SolidColorBrush x:Key="SettingsSidebarIcon" Color="#6E6E73"/>
  <SolidColorBrush x:Key="SettingsSidebarSelectionInk" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SettingsSelection" Color="#007AFF"/>
  <SolidColorBrush x:Key="SettingsAccent" Color="#007AFF"/>
  <SolidColorBrush x:Key="SettingsAccentHover" Color="#1C88FF"/>
  <SolidColorBrush x:Key="SettingsAccentPressed" Color="#0062CC"/>
  <SolidColorBrush x:Key="SettingsOnAccent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SettingsSwitchOff" Color="#33787880"/>
  <SolidColorBrush x:Key="SettingsHover" Color="#0A000000"/>
  <SolidColorBrush x:Key="SettingsPressed" Color="#14000000"/>
  <SolidColorBrush x:Key="SettingsControlStroke" Color="#1F000000"/>
  <SolidColorBrush x:Key="SettingsKnob" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SettingsFocusRing" Color="#73007AFF"/>
  <SolidColorBrush x:Key="SettingsScrollThumb" Color="#47000000"/>
  <SolidColorBrush x:Key="SettingsMenu" Color="#FAFAFC"/>
  <SolidColorBrush x:Key="SettingsMenuStroke" Color="#1A000000"/>
  <SolidColorBrush x:Key="SettingsGroupEdge" Color="#0F000000"/>
  <LinearGradientBrush x:Key="SettingsControlFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#FBFBFD" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="SettingsControlSheen" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#99FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset=".5"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="SettingsPrimaryFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2A8FFF" Offset="0"/><GradientStop Color="#007AFF" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="SettingsPrimarySheen" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#40FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset=".55"/></LinearGradientBrush>
  <Color x:Key="SettingsShadowColor">#000000</Color>
  <Color x:Key="SettingsAccentColor">#007AFF</Color>
  <sys:Double x:Key="SettingsControlShadowOpacity">0.14</sys:Double>
  <sys:Double x:Key="SettingsFloatingShadowOpacity">0.17</sys:Double>
  <CornerRadius x:Key="SettingsCardRadius">12</CornerRadius>
  <Thickness x:Key="SettingsPagePadding">32,8,32,28</Thickness>

  <!-- Inset group: porcelain on pearl in light mode, graphite lifted by a top edge of light in dark mode. -->
  <Style x:Key="SettingsSurface" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource SettingsCardRadius}"/>
    <Setter Property="Background" Value="{DynamicResource SettingsCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsGroupEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style TargetType="ListBox"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="Expander"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="ToggleButton"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="RepeatButton"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="Thumb"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/></Style>

  <!-- Push button: white (or graphite) face, a hairline of light on top, a soft shadow below. -->
  <Style TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
    <Setter Property="Background" Value="{DynamicResource SettingsControlFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="14,5"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Body" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <Border.Effect><DropShadowEffect x:Name="Lift" BlurRadius="2.5" ShadowDepth=".6" Direction="270" Color="{DynamicResource SettingsShadowColor}" Opacity="{DynamicResource SettingsControlShadowOpacity}"/></Border.Effect>
            </Border>
            <Border x:Name="Sheen" CornerRadius="6" Margin="1" Background="{DynamicResource SettingsControlSheen}" IsHitTestVisible="False"/>
            <Border x:Name="State" CornerRadius="7" Background="Transparent" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="State" Property="Background" Value="{DynamicResource SettingsHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="State" Property="Background" Value="{DynamicResource SettingsPressed}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource SettingsFocusRing}"/></Trigger>
            <Trigger Property="Background" Value="Transparent"><Setter TargetName="Sheen" Property="Visibility" Value="Collapsed"/><Setter TargetName="Body" Property="Effect" Value="{x:Null}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Default action: accent face lit from above, with a faint accent-coloured shadow. -->
  <Style x:Key="SettingsPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource SettingsOnAccent}"/>
    <Setter Property="Background" Value="{DynamicResource SettingsPrimaryFill}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Body" CornerRadius="7" Background="{TemplateBinding Background}">
              <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1.2" Direction="270" Color="{DynamicResource SettingsAccentColor}" Opacity=".32"/></Border.Effect>
            </Border>
            <Border CornerRadius="6.5" Margin=".5" Background="{DynamicResource SettingsPrimarySheen}" IsHitTestVisible="False"/>
            <Border x:Name="State" CornerRadius="7" Background="Transparent" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="State" Property="Background" Value="#14FFFFFF"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="State" Property="Background" Value="#26000000"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Borderless tool button (toolbar chevrons, sidebar toggle): only a quiet fill on hover. -->
  <Style x:Key="SettingsToolButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" CornerRadius="6" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource SettingsHover}"/><Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource SettingsPressed}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".3"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text field with a macOS focus ring that blooms outside the edge. -->
  <Style TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Background" Value="{DynamicResource SettingsField}"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="CaretBrush" Value="{DynamicResource SettingsAccent}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource SettingsAccent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border x:Name="Ring" CornerRadius="9" Margin="-3" BorderBrush="{DynamicResource SettingsFocusRing}" BorderThickness="3" Opacity="0" IsHitTestVisible="False"/>
            <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Overlay-style scroll bar: a slim rounded thumb that thickens under the pointer. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="11"/>
    <Setter Property="MinWidth" Value="11"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid x:Name="Lane" Width="11" Background="Transparent" Margin="0,4">
            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
              <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb MinHeight="28">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="Grip" Width="6" CornerRadius="3" HorizontalAlignment="Center" Background="{DynamicResource SettingsScrollThumb}"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Width" Value="8"/><Setter TargetName="Grip" Property="CornerRadius" Value="4"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Width" Value="8"/><Setter TargetName="Grip" Property="CornerRadius" Value="4"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Window controls: 12 px traffic lights; glyphs appear when the pointer is over the group. -->
  <Style x:Key="SettingsTrafficButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Ellipse x:Name="Light" Width="12" Height="12" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness=".6"/>
            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True"><Setter TargetName="Glyph" Property="Opacity" Value="1"/></DataTrigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Light" Property="Opacity" Value=".72"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Menus (combo drop-downs): a floating sheet; the hovered row fills with accent, the chosen row shows a check. -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Padding" Value="6,5,12,5"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Choice" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Path x:Name="Check" Data="M1,5 L4.2,8.2 L11,1.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="10" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="3,0,0,0" Visibility="Hidden"/>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource SettingsAccent}"/><Setter Property="Foreground" Value="{DynamicResource SettingsOnAccent}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Pop-up button in the System Settings manner: value text and a small double chevron, quiet until hovered. -->
  <Style TargetType="ComboBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
    <Setter Property="Background" Value="{DynamicResource SettingsControlFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Body" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <Border.Effect><DropShadowEffect BlurRadius="2.5" ShadowDepth=".6" Direction="270" Color="{DynamicResource SettingsShadowColor}" Opacity="{DynamicResource SettingsControlShadowOpacity}"/></Border.Effect>
            </Border>
            <Border CornerRadius="6" Margin="1" Background="{DynamicResource SettingsControlSheen}" IsHitTestVisible="False"/>
            <Border x:Name="State" CornerRadius="7" Background="Transparent" IsHitTestVisible="False"/>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,4,30,4" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
            <Path Data="M0,4 L3.5,0.5 L7,4 M0,7.5 L3.5,11 L7,7.5" Stroke="{DynamicResource SettingsMuted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="7" Height="11.5" Stretch="None" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" IsHitTestVisible="False"/>
            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <!-- The sheet keeps a margin for its shadow; the offsets put its visible edge 4 px under the button. -->
            <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="-14" VerticalOffset="0" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
              <Grid Margin="14,4,14,22">
                <Border CornerRadius="10" Background="{DynamicResource SettingsMenu}">
                  <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Color="{DynamicResource SettingsShadowColor}" Opacity="{DynamicResource SettingsFloatingShadowOpacity}"/></Border.Effect>
                </Border>
                <Border CornerRadius="10" BorderBrush="{DynamicResource SettingsMenuStroke}" BorderThickness="1" Padding="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="340" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="State" Property="Background" Value="{DynamicResource SettingsHover}"/></Trigger>
            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="State" Property="Background" Value="{DynamicResource SettingsPressed}"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource SettingsFocusRing}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Switch row. SettingsSwitchMotion drives the knob travel, the press stretch and the accent fill. -->
  <Style TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="local:SettingsSwitchMotion.Enabled" Value="True"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid MinHeight="44" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ContentPresenter Margin="0,10,16,10" VerticalAlignment="Center">
              <ContentPresenter.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13.5"/></DataTemplate></ContentPresenter.ContentTemplate>
            </ContentPresenter>
            <Grid Grid.Column="1" Width="40" Height="24" VerticalAlignment="Center">
              <Border x:Name="Ring" CornerRadius="15" Margin="-3" BorderBrush="{DynamicResource SettingsFocusRing}" BorderThickness="3" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="SwitchTrack" Width="40" CornerRadius="12" Background="{DynamicResource SettingsSwitchOff}"/>
              <Border x:Name="SwitchKnob" Width="20" Height="20" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="10" Background="{DynamicResource SettingsKnob}" RenderTransformOrigin=".5,.5">
                <Border.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="3" ShadowDepth=".8" Direction="270" Color="#000000" Opacity=".26"/></Border.Effect>
              </Border>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented control: a quiet trough with a lifted thumb. -->
  <Style TargetType="local:SettingsSegmentedControl">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="VerticalContentAlignment" Value="Center"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Segment" CornerRadius="6" Background="Transparent">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,4"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="False"><Setter Property="Opacity" Value=".72"/></Trigger>
                  <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter Property="Opacity" Value="1"/></MultiTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:SettingsSegmentedControl">
          <Border Background="{DynamicResource SettingsQuiet}" CornerRadius="8" Padding="2">
            <Grid>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="6" Background="{DynamicResource SettingsIndicator}" IsHitTestVisible="False">
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="3" ShadowDepth=".7" Direction="270" Color="{DynamicResource SettingsShadowColor}" Opacity="{DynamicResource SettingsControlShadowOpacity}"/></Border.Effect>
              </Border>
              <ItemsPresenter/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slider: slim accent track and a pearl knob that sits slightly above the surface. -->
  <Style TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="28" Background="Transparent">
            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource SettingsAccent}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource SettingsTrack}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb FocusVisualStyle="{x:Null}" Width="20" Height="20">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid>
                        <Ellipse x:Name="Halo" Margin="-3" Stroke="{DynamicResource SettingsFocusRing}" StrokeThickness="3" Opacity="0"/>
                        <Ellipse Fill="{DynamicResource SettingsKnob}" Stroke="{DynamicResource SettingsControlStroke}" StrokeThickness=".6">
                          <Ellipse.Effect><DropShadowEffect BlurRadius="3.5" ShadowDepth="1" Direction="270" Color="#000000" Opacity=".24"/></Ellipse.Effect>
                        </Ellipse>
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Halo" Property="Opacity" Value=".55"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tooltips: a small floating label. -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Grid Margin="8,4,8,12">
            <Border CornerRadius="6" Background="{DynamicResource SettingsMenu}">
              <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="{DynamicResource SettingsShadowColor}" Opacity="{DynamicResource SettingsFloatingShadowOpacity}"/></Border.Effect>
            </Border>
            <Border CornerRadius="6" BorderBrush="{DynamicResource SettingsMenuStroke}" BorderThickness="1" Padding="9,4,9,5"><ContentPresenter/></Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Sidebar rows. The accent pill behind the selected row is SettingsShellWindow._selection, which glides. -->
  <SolidColorBrush x:Key="SettingsSidebarHover" Color="#0A000000"/>
  <Style x:Key="SettingsNavigationGlyph" TargetType="Path"><Setter Property="Fill" Value="{DynamicResource SettingsSidebarIcon}"/></Style>
  <Style x:Key="SettingsNavigationItem" TargetType="ListBoxItem">
    <Setter Property="Height" Value="34"/>
    <Setter Property="Margin" Value="10,1"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsSidebarInk}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Hover" CornerRadius="7" Padding="7,0" Background="Transparent"><ContentPresenter VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource SettingsSidebarSelectionInk}"/></Trigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Hover" Property="Background" Value="{DynamicResource SettingsSidebarHover}"/></MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
