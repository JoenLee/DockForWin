<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:DockForWindows.Views">
  <!-- Settings window controls in the macOS 26 manner. Values below are the light (Porcelain) defaults;
       SettingsShellWindow replaces every brush from DesignSystem at runtime, so light and dark share one set of
       templates. Faces are frosted (white with alpha), labels and fills carry alpha so the desktop's hue reaches
       through, light comes from the upper left: a bright inner rim on top, a soft shadow below. -->
  <SolidColorBrush x:Key="SettingsInk" Color="#D9000000"/>
  <SolidColorBrush x:Key="SettingsMuted" Color="#85000000"/>
  <SolidColorBrush x:Key="SettingsTertiary" Color="#4D000000"/>
  <SolidColorBrush x:Key="SettingsLine" Color="#14000000"/>
  <SolidColorBrush x:Key="SettingsCard" Color="#A6FFFFFF"/>
  <SolidColorBrush x:Key="SettingsField" Color="#C7FFFFFF"/>
  <SolidColorBrush x:Key="SettingsCanvas" Color="Transparent"/>
  <SolidColorBrush x:Key="SettingsSidebar" Color="Transparent"/>
  <SolidColorBrush x:Key="SettingsHero" Color="#0F000000"/>
  <SolidColorBrush x:Key="SettingsTrack" Color="#17000000"/>
  <SolidColorBrush x:Key="SettingsQuiet" Color="#0F000000"/>
  <SolidColorBrush x:Key="SettingsIndicator" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SettingsSidebarInk" Color="#D9000000"/>
  <SolidColorBrush x:Key="SettingsSidebarIcon" Color="#85000000"/>
  <SolidColorBrush x:Key="SettingsSidebarSelectionInk" Color="#D9000000"/>
  <SolidColorBrush x:Key="SettingsSelection" Color="#14000000"/>
  <SolidColorBrush x:Key="SettingsAccent" Color="#0088FF"/>
  <SolidColorBrush x:Key="SettingsAccentHover" Color="#1F96FF"/>
  <SolidColorBrush x:Key="SettingsAccentPressed" Color="#0074E6"/>
  <SolidColorBrush x:Key="SettingsOnAccent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SettingsSwitchOff" Color="#21000000"/>
  <SolidColorBrush x:Key="SettingsHover" Color="#0B000000"/>
  <SolidColorBrush x:Key="SettingsPressed" Color="#17000000"/>
  <SolidColorBrush x:Key="SettingsControlStroke" Color="#14000000"/>
  <SolidColorBrush x:Key="SettingsKnob" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SettingsFocusRing" Color="#6B0088FF"/>
  <SolidColorBrush x:Key="SettingsScrollThumb" Color="#40000000"/>
  <SolidColorBrush x:Key="SettingsMenu" Color="#F7FBFBFD"/>
  <SolidColorBrush x:Key="SettingsMenuStroke" Color="#14000000"/>
  <SolidColorBrush x:Key="SettingsGroupHighlight" Color="#CCFFFFFF"/>
  <LinearGradientBrush x:Key="SettingsGroupEdge" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0D000000" Offset="0"/><GradientStop Color="#0D000000" Offset=".35"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="SettingsControlFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#D9FFFFFF" Offset="0"/><GradientStop Color="#B3FFFFFF" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="SettingsGlassControl" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#D9FFFFFF" Offset="0"/><GradientStop Color="#B3FFFFFF" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="SettingsGlassRim" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E6FFFFFF" Offset="0"/><GradientStop Color="#33FFFFFF" Offset=".42"/><GradientStop Color="#33FFFFFF" Offset=".7"/><GradientStop Color="#7EFFFFFF" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="SettingsControlSheen" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#99FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset=".5"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="SettingsPrimaryFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1F96FF" Offset="0"/><GradientStop Color="#0088FF" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="SettingsPrimarySheen" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#47FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset=".55"/></LinearGradientBrush>
  <Color x:Key="SettingsShadowColor">#000000</Color>
  <Color x:Key="SettingsAccentColor">#0088FF</Color>
  <sys:Double x:Key="SettingsControlShadowOpacity">0.12</sys:Double>
  <sys:Double x:Key="SettingsFloatingShadowOpacity">0.16</sys:Double>
  <sys:Double x:Key="SettingsGlassShadowOpacity">0.09</sys:Double>
  <SolidColorBrush x:Key="SettingsRaised" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SettingsRaisedEdge" Color="#0F0A1A33"/>
  <SolidColorBrush x:Key="SettingsDanger" Color="#C9302C"/>
  <LinearGradientBrush x:Key="SettingsCanvasFadeUp" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00EEF1F5" Offset="0"/><GradientStop Color="#EEF1F5" Offset="1"/></LinearGradientBrush>
  <sys:Double x:Key="SettingsRaisedShadowOpacity">0.1</sys:Double>
  <CornerRadius x:Key="SettingsCardRadius">12</CornerRadius>
  <Thickness x:Key="SettingsPagePadding">28,8,28,28</Thickness>

  <!-- Inset group: a frosted pane over the window veil, its hairline brighter along the top. -->
  <Style x:Key="SettingsSurface" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource SettingsCardRadius}"/>
    <Setter Property="Background" Value="{DynamicResource SettingsCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsGroupEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style TargetType="ListBox"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="ToggleButton"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="RepeatButton"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="Thumb"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/></Style>

  <!-- Push button: a capsule of frosted glass with a bright inner rim on top and a soft shadow below. -->
  <Style TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
    <Setter Property="Background" Value="{DynamicResource SettingsControlFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="15,5"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Body" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <Border.Effect><DropShadowEffect x:Name="Lift" BlurRadius="7" ShadowDepth="1.5" Direction="270" Color="{DynamicResource SettingsShadowColor}" Opacity="{DynamicResource SettingsControlShadowOpacity}"/></Border.Effect>
            </Border>
            <Border x:Name="Sheen" CornerRadius="13" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource SettingsControlSheen}" IsHitTestVisible="False"/>
            <Border x:Name="State" CornerRadius="14" Background="Transparent" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="State" Property="Background" Value="{DynamicResource SettingsHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="State" Property="Background" Value="{DynamicResource SettingsPressed}"/></Trigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="local:KeyboardCue.Visible" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource SettingsFocusRing}"/></MultiTrigger>
            <Trigger Property="Background" Value="Transparent"><Setter TargetName="Sheen" Property="Visibility" Value="Collapsed"/><Setter TargetName="Body" Property="Effect" Value="{x:Null}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Default action: a capsule of lightly blue-tinted glass with accent ink — light, never a heavy block of colour. -->
  <SolidColorBrush x:Key="SettingsPrimaryTint" Color="#242F8FFF"/>
  <SolidColorBrush x:Key="SettingsPrimaryRim" Color="#472F8FFF"/>
  <SolidColorBrush x:Key="SettingsAccentInk" Color="#0A6AD6"/>
  <Style x:Key="SettingsPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource SettingsAccentInk}"/>
    <Setter Property="Background" Value="{DynamicResource SettingsPrimaryTint}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsPrimaryRim}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Body" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness=".75"/>
            <Border CornerRadius="13" Margin="1" BorderThickness="0,1,0,0" BorderBrush="#80FFFFFF" IsHitTestVisible="False"/>
            <Border x:Name="State" CornerRadius="14" Background="Transparent" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="State" Property="Background" Value="{DynamicResource SettingsPrimaryTint}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="State" Property="Background" Value="{DynamicResource SettingsPrimaryRim}"/></Trigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="local:KeyboardCue.Visible" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource SettingsFocusRing}"/></MultiTrigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Tool button inside a glass capsule (toolbar chevrons, sidebar toggle): a round quiet fill under the pointer. -->
  <Style x:Key="SettingsToolButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Body" CornerRadius="13" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource SettingsHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource SettingsPressed}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".3"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text field: a frosted well with a macOS focus ring that blooms outside the edge. -->
  <Style TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Background" Value="{DynamicResource SettingsField}"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="9,2"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="CaretBrush" Value="{DynamicResource SettingsAccent}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource SettingsAccent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border x:Name="Ring" CornerRadius="10.5" Margin="-2.5" BorderBrush="{DynamicResource SettingsFocusRing}" BorderThickness="2.5" Opacity="0" IsHitTestVisible="False"/>
            <!-- No Padding on the border: TextBox already pads its content host with its own Padding, and doing it
                 twice pushed typed text far to the right of the search icon (audit S06-12). -->
            <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value=".75"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Overlay-style scroll bar: a slim rounded thumb that thickens under the pointer. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="11"/>
    <Setter Property="MinWidth" Value="11"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid x:Name="Lane" Width="11" Background="Transparent" Margin="0,4">
            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
              <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb MinHeight="28">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="Grip" Width="6" CornerRadius="3" HorizontalAlignment="Center" Background="{DynamicResource SettingsScrollThumb}"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Width" Value="8"/><Setter TargetName="Grip" Property="CornerRadius" Value="4"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Width" Value="8"/><Setter TargetName="Grip" Property="CornerRadius" Value="4"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Overlay scrolling: the bar floats over the right edge of the content instead of taking a column, so a page
       never shifts sideways when it becomes long enough to scroll. It shows while the pointer is over the page. -->
  <Style TargetType="ScrollViewer">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid Background="{TemplateBinding Background}">
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" CanHorizontallyScroll="False" CanVerticallyScroll="False" Margin="{TemplateBinding Padding}" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}"/>
            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Margin="0,0,2,0" Orientation="Vertical" Cursor="Arrow" Opacity="0"
                       Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                       ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            <ScrollBar x:Name="PART_HorizontalScrollBar" Visibility="Collapsed" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Disclosure: the title in body text with a thin chevron that turns as the section opens. -->
  <Style x:Key="SettingsExpander" TargetType="Expander">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton x:Name="HeaderSite" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="True" Cursor="Hand" HorizontalAlignment="Left" Foreground="{TemplateBinding Foreground}"
                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Wash" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="7" Padding="6,5,8,5" Margin="-6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <Path x:Name="Chevron" Data="M1,1 L5,5 L1,9" Stroke="{DynamicResource SettingsMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Width="6" Height="10" Stretch="None" VerticalAlignment="Center" Margin="2,0,9,0" RenderTransformOrigin=".4,.5">
                        <Path.RenderTransform><RotateTransform x:Name="Turn" Angle="0"/></Path.RenderTransform>
                      </Path>
                      <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="13" TextElement.FontWeight="Medium"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Wash" Property="Background" Value="{DynamicResource SettingsHover}"/></Trigger>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="local:KeyboardCue.Visible" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Wash" Property="Background" Value="{DynamicResource SettingsHover}"/><Setter TargetName="Wash" Property="BorderBrush" Value="{DynamicResource SettingsFocusRing}"/></MultiTrigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Turn" Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                      <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Turn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"/>
            </ToggleButton>
            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="0,6,0,0"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Expander" BasedOn="{StaticResource SettingsExpander}"/>

  <!-- Window controls: 12 px traffic lights; glyphs appear when the pointer is over the group. -->
  <Style x:Key="SettingsTrafficButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Ellipse x:Name="Light" Width="12.5" Height="12.5" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness=".6"/>
            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True"><Setter TargetName="Glyph" Property="Opacity" Value="1"/></DataTrigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Light" Property="Opacity" Value=".72"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Menus (combo drop-downs): a floating sheet with a 12 px radius; the hovered row fills with accent, the chosen row shows a check. -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Padding" Value="6,5,12,5"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Choice" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Path x:Name="Check" Data="M1,5 L4.2,8.2 L11,1.5" Stroke="{DynamicResource SettingsAccentInk}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="10" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="3,0,0,0" Visibility="Hidden"/>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <!-- The current value is marked by a check only; the row under the pointer gets a soft accent wash, never a solid block. -->
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource SettingsPrimaryTint}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Pop-up button: a frosted face with the value and a small double chevron, quiet until hovered. -->
  <Style TargetType="ComboBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
    <Setter Property="Background" Value="{DynamicResource SettingsControlFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Body" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
            <Border CornerRadius="7" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource SettingsControlSheen}" IsHitTestVisible="False"/>
            <Border x:Name="State" CornerRadius="8" Background="Transparent" IsHitTestVisible="False"/>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,4,30,4" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
            <Path Data="M0,4 L3.5,0.5 L7,4 M0,7.5 L3.5,11 L7,7.5" Stroke="{DynamicResource SettingsMuted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="7" Height="11.5" Stretch="None" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <!-- The sheet keeps a margin for its shadow; the offsets put its visible edge 4 px under the button. -->
            <Popup x:Name="PART_Popup" Placement="Relative" HorizontalOffset="-14" VerticalOffset="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
              <Grid Margin="14,4,14,24">
                <Border CornerRadius="12" Background="{DynamicResource SettingsMenu}">
                  <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="9" Direction="270" Color="{DynamicResource SettingsShadowColor}" Opacity="{DynamicResource SettingsFloatingShadowOpacity}"/></Border.Effect>
                </Border>
                <Border CornerRadius="12" BorderBrush="{DynamicResource SettingsMenuStroke}" BorderThickness="1" Padding="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="340" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
                <Border CornerRadius="11" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource SettingsControlSheen}" IsHitTestVisible="False"/>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="State" Property="Background" Value="{DynamicResource SettingsHover}"/></Trigger>
            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="State" Property="Background" Value="{DynamicResource SettingsPressed}"/></Trigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocusWithin" Value="True"/><Condition Property="IsDropDownOpen" Value="False"/><Condition Property="local:KeyboardCue.Visible" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource SettingsFocusRing}"/></MultiTrigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Switch row, macOS 26: a capsule knob on a capsule track. SettingsSwitchMotion drives the knob travel,
       the press stretch and the accent fill. -->
  <Style TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="local:SettingsSwitchMotion.Enabled" Value="True"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid MinHeight="44" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ContentPresenter Margin="0,10,16,10" VerticalAlignment="Center">
              <ContentPresenter.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13.5"/></DataTemplate></ContentPresenter.ContentTemplate>
            </ContentPresenter>
            <Grid Grid.Column="1" Width="44" Height="24" VerticalAlignment="Center">
              <Border x:Name="Ring" CornerRadius="15" Margin="-3" BorderBrush="{DynamicResource SettingsFocusRing}" BorderThickness="3" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="SwitchTrack" Width="44" CornerRadius="12" Background="{DynamicResource SettingsSwitchOff}"/>
              <Border x:Name="SwitchKnob" Width="27" Height="20" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="10" Background="{DynamicResource SettingsKnob}" BorderBrush="#0D000000" BorderThickness=".5" RenderTransformOrigin=".5,.5">
                <Border.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1.2" Direction="270" Color="#000000" Opacity=".24"/></Border.Effect>
              </Border>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="local:KeyboardCue.Visible" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Ring" Property="Opacity" Value="1"/></MultiTrigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented control: a capsule trough with a lifted capsule thumb. -->
  <Style TargetType="local:SettingsSegmentedControl">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="VerticalContentAlignment" Value="Center"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Segment" CornerRadius="8" Background="Transparent">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,4"/>
                </Border>
                <!-- Chosen: ink on the raised pill; the others are quieter ink that firms up under the pointer. -->
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="False"><Setter Property="Foreground" Value="{DynamicResource SettingsMuted}"/></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                  <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/></MultiTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:SettingsSegmentedControl">
          <Grid>
          <Border x:Name="Ring" CornerRadius="12" Margin="-2.5" BorderBrush="{DynamicResource SettingsFocusRing}" BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
          <Border Background="{DynamicResource SettingsQuiet}" CornerRadius="10" Padding="2">
            <Grid>
              <!-- The chosen segment is a raised neutral pill (white in light, lifted graphite in dark): selection is
                   not "on", so it is never painted with the accent. -->
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="8" Background="{DynamicResource SettingsRaised}" BorderBrush="{DynamicResource SettingsRaisedEdge}" BorderThickness=".75" IsHitTestVisible="False">
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="{DynamicResource SettingsShadowColor}" Opacity="{DynamicResource SettingsRaisedShadowOpacity}"/></Border.Effect>
              </Border>
              <ItemsPresenter/>
            </Grid>
          </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocusWithin" Value="True"/><Condition Property="local:KeyboardCue.Visible" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Ring" Property="Opacity" Value="1"/></MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slider, macOS 26: a slim accent track and a capsule knob that floats just above the surface. -->
  <Style TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="28" Background="Transparent">
            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <!-- A slim line rather than a bar: 4 DIP, accent fill only while the slider can be used. -->
              <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border x:Name="Fill" Height="4" CornerRadius="2" Margin="0,0,-10,0" VerticalAlignment="Center" Background="{DynamicResource SettingsAccent}"/><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Fill" Property="Background" Value="{DynamicResource SettingsTertiary}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="4" CornerRadius="2" Margin="-10,0,0,0" VerticalAlignment="Center" Background="{DynamicResource SettingsTrack}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb FocusVisualStyle="{x:Null}" Width="24" Height="17">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid x:Name="KnobRoot" RenderTransformOrigin=".5,.5">
                        <Border x:Name="Halo" Margin="-3" CornerRadius="11.5" BorderBrush="{DynamicResource SettingsFocusRing}" BorderThickness="3" Opacity="0"/>
                        <Border CornerRadius="8.5" Background="{DynamicResource SettingsKnob}" BorderBrush="#140B1730" BorderThickness=".5">
                          <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1.2" Direction="270" Color="{DynamicResource SettingsShadowColor}" Opacity=".24"/></Border.Effect>
                        </Border>
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="KnobRoot" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.05" ScaleY="1.05"/></Setter.Value></Setter></Trigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True"/><Condition Binding="{Binding (local:KeyboardCue.Visible), RelativeSource={RelativeSource AncestorType=Slider}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="Halo" Property="Opacity" Value="1"/></MultiDataTrigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Halo" Property="Opacity" Value=".35"/><Setter TargetName="KnobRoot" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.12" ScaleY="1.04"/></Setter.Value></Setter></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tooltips: a small floating label. -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Grid Margin="8,4,8,12">
            <Border CornerRadius="8" Background="{DynamicResource SettingsMenu}">
              <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="{DynamicResource SettingsShadowColor}" Opacity="{DynamicResource SettingsFloatingShadowOpacity}"/></Border.Effect>
            </Border>
            <Border CornerRadius="8" BorderBrush="{DynamicResource SettingsMenuStroke}" BorderThickness="1" Padding="9,4,9,5"><ContentPresenter/></Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Sidebar rows. The neutral pill behind the selected row is SettingsShellWindow._selection, which glides. -->
  <SolidColorBrush x:Key="SettingsSidebarHover" Color="#0B000000"/>
  <Style x:Key="SettingsNavigationGlyph" TargetType="Path"><Setter Property="Fill" Value="{DynamicResource SettingsSidebarIcon}"/></Style>
  <Style x:Key="SettingsNavigationItem" TargetType="ListBoxItem">
    <Setter Property="Height" Value="36"/>
    <Setter Property="Margin" Value="8,1"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsSidebarInk}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Hover" CornerRadius="8" Padding="6,0" Background="Transparent"><ContentPresenter VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource SettingsSidebarSelectionInk}"/></Trigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Hover" Property="Background" Value="{DynamicResource SettingsSidebarHover}"/></MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
